{
  "name": "application-regression-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright regression framework for java-application-support-lab",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report playwright-report",
    "test:allure": "allure generate allure-results --clean -o allure-report",
    "test:allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.15.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.3.0",
    "dotenv": "^17.2.0",
    "typescript": "^5.8.3"
  }
}
